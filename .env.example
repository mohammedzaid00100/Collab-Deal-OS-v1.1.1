# Public application origin used for trusted metadata and OAuth callbacks.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Only this public origin is embedded in the Android wrapper.
CAPACITOR_SERVER_URL=

# Supabase public browser configuration. The anon key is designed for clients;
# Row Level Security remains mandatory.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy fallback for older Supabase projects only.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only secrets. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# Legacy fallback for older Supabase projects only.
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
# Pin a Responses API model that supports strict structured outputs.
OPENAI_MODEL=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Optional old secret while Razorpay retries deliveries during key rotation.
RAZORPAY_PREVIOUS_WEBHOOK_SECRET=
RAZORPAY_ACCOUNT_ID=
# RazorpayX live VPA validation. Keep disabled until the RazorpayX account,
# source account/customer identifier and server IP allowlisting are ready.
RAZORPAYX_LIVE_VPA_VALIDATION=false
RAZORPAYX_SOURCE_ACCOUNT_NUMBER=
RAZORPAY_CREATOR_PRO_PLAN_ID=
RAZORPAY_CREATOR_PREMIUM_PLAN_ID=
RAZORPAY_BRAND_PRO_PLAN_ID=
RAZORPAY_BRAND_PREMIUM_PLAN_ID=
# Required maximum number of monthly cycles. Set explicitly before checkout.
RAZORPAY_SUBSCRIPTION_TOTAL_COUNT=
RESEND_API_KEY=
# Authenticates the scheduled maintenance endpoint (at least 32 random characters).
MAINTENANCE_JOB_SECRET=
GOOGLE_OAUTH_CONFIGURED=false
ENABLE_SETUP_STATUS=false

# Razorpay's publishable identifier is safe for checkout UI.
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Public analytics project configuration.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# Optional transactional email identity.
RESEND_FROM_EMAIL=Collab Deal OS <deals@example.com>
