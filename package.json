    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "node scripts/test-database.mjs",
    "android:prepare": "node scripts/android-prepare.mjs",
    "android:open": "cap open android",
    "setup": "node scripts/setup.mjs",
