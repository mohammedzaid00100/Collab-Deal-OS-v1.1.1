    "lucide-react": "^1.35.0",
    "next": "^16.3.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.86.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
